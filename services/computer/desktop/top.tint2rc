# Lightweight top bar. One clock, no compositor.
rounded = 0
border_width = 0
background_color = #f6f4f1 100
border_color = #e6e0d8 100

panel_items = E C
panel_size = 100% 28
panel_margin = 0 0
panel_padding = 6 0 6
panel_background_id = 1
wm_menu = 0
panel_dock = 0
panel_position = top center horizontal
panel_layer = top
panel_monitor = all
panel_shrink = 0
autohide = 0
strut_policy = follow_size
panel_window_name = teammates-top
disable_transparency = 1
font_shadow = 0
mouse_effects = 0

time1_format = %H:%M
time1_font = DejaVu Sans 10
time2_format =
clock_font_color = #111111 100
clock_padding = 2 0
clock_background_id = 0
clock_tooltip =
clock_lclick_command =
clock_rclick_command =

execp = new
execp_command = echo Applications
execp_interval = 0
execp_continuous = 0
execp_has_icon = 0
execp_markup = 0
execp_tooltip = Applications
execp_font = DejaVu Sans 10
execp_font_color = #111111 100
execp_padding = 8 0 4
execp_background_id = 0
execp_centered = 0
execp_lclick_command = xdotool key --clearmodifiers alt+F1
execp_rclick_command = xdotool key --clearmodifiers alt+F1
