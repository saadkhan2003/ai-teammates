#!/bin/sh
export DISPLAY="${DISPLAY:-:1}"
if [ -z "${BOT_ROOT:-}" ]; then
  pid=$(pidof openbox 2>/dev/null || true)
  if [ -n "$pid" ] && [ -r "/proc/$pid/environ" ]; then
    BOT_ROOT=$(tr '\0' '\n' < "/proc/$pid/environ" | sed -n 's/^BOT_ROOT=//p' | head -1)
    HOME=$(tr '\0' '\n' < "/proc/$pid/environ" | sed -n 's/^HOME=//p' | head -1)
  fi
fi
if [ -z "${BOT_ROOT:-}" ]; then
  for script in /run/service/wm-*/run; do
    [ -r "$script" ] || continue
    BOT_ROOT=$(sed -n 's/^export BOT_ROOT=//p' "$script" | head -1)
    HOME=$(sed -n 's/^export HOME=//p' "$script" | head -1)
    [ -n "$BOT_ROOT" ] && break
  done
fi
if [ -n "${BOT_ROOT:-}" ] && [ -d "$BOT_ROOT" ]; then
  cd "$BOT_ROOT"
fi
exec xterm -fa 'DejaVu Sans Mono' -fs 11 -title 'Terminal'
