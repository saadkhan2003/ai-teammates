#!/bin/sh
export DISPLAY="${DISPLAY:-:1}"
if [ -z "${BOT_ROOT:-}" ]; then
  for script in /run/service/wm-*/run; do
    [ -r "$script" ] || continue
    BOT_ROOT=$(sed -n 's/^export BOT_ROOT=//p' "$script" | head -1)
    [ -n "$BOT_ROOT" ] && break
  done
fi
if [ -z "${BOT_ROOT:-}" ] || [ ! -d "$BOT_ROOT" ]; then
  echo "bot workspace is not available" >&2
  exit 1
fi
cd "$BOT_ROOT"
exec thunar "$BOT_ROOT"
