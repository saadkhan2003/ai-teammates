<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <resistance>
    <strength>10</strength>
    <screen_edge_strength>20</screen_edge_strength>
  </resistance>
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
    <focusDelay>200</focusDelay>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>
  <placement>
    <policy>Smart</policy>
    <center>yes</center>
  </placement>
  <theme>
    <name>Clearlooks</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>yes</keepBorder>
    <animateIconify>no</animateIconify>
    <font place="ActiveWindow"><name>DejaVu Sans</name><size>10</size><weight>Normal</weight><slant>Normal</slant></font>
    <font place="InactiveWindow"><name>DejaVu Sans</name><size>10</size><weight>Normal</weight><slant>Normal</slant></font>
    <font place="MenuHeader"><name>DejaVu Sans</name><size>10</size><weight>Normal</weight><slant>Normal</slant></font>
    <font place="MenuItem"><name>DejaVu Sans</name><size>10</size><weight>Normal</weight><slant>Normal</slant></font>
    <font place="ActiveOnScreenDisplay"><name>DejaVu Sans</name><size>10</size><weight>Normal</weight><slant>Normal</slant></font>
    <font place="InactiveOnScreenDisplay"><name>DejaVu Sans</name><size>10</size><weight>Normal</weight><slant>Normal</slant></font>
  </theme>
  <desktops>
    <number>1</number>
    <firstdesk>1</firstdesk>
    <popupTime>0</popupTime>
  </desktops>
  <resize>
    <drawContents>yes</drawContents>
    <popupShow>Never</popupShow>
  </resize>
  <margins>
    <top>0</top>
    <bottom>0</bottom>
    <left>0</left>
    <right>0</right>
  </margins>
  <applications>
    <application class="*">
      <maximized>yes</maximized>
    </application>
  </applications>
  <menu>
    <file>/etc/xdg/openbox/menu.xml</file>
    <hideDelay>2000</hideDelay>
    <middle>no</middle>
    <submenuShowDelay>0</submenuShowDelay>
    <showIcons>yes</showIcons>
  </menu>
  <keyboard>
    <keybind key="A-F1">
      <action name="ShowMenu">
        <menu>root-menu</menu>
      </action>
    </keybind>
  </keyboard>
  <mouse>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu">
          <menu>root-menu</menu>
        </action>
      </mousebind>
    </context>
  </mouse>
</openbox_config>
