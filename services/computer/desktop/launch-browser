#!/bin/sh
# Raise the main Chromium window. Helper windows share the class and are tiny.
export DISPLAY="${DISPLAY:-:1}"
best=""
bestarea=0
ids=$(xdotool search --class chromium 2>/dev/null || true)
ids="$ids $(xdotool search --class Chromium 2>/dev/null || true)"
for id in $ids; do
  geom=$(xdotool getwindowgeometry --shell "$id" 2>/dev/null || true)
  width=$(printf '%s\n' "$geom" | awk -F= '/^WIDTH=/{print $2}')
  height=$(printf '%s\n' "$geom" | awk -F= '/^HEIGHT=/{print $2}')
  [ -n "$width" ] && [ -n "$height" ] || continue
  area=$((width * height))
  if [ "$area" -gt "$bestarea" ]; then
    bestarea=$area
    best=$id
  fi
done
if [ -n "$best" ]; then
  xdotool windowactivate "$best" >/dev/null 2>&1 || true
  xdotool windowraise "$best" >/dev/null 2>&1 || true
else
  # A secondary display starts without Chromium to save memory. Launch on demand
  # as the panel's bot UID, with a distinct profile and the same lean defaults.
  export PYTHONPATH=/opt/desk/src
  exec /opt/desk/venv/bin/python -c '
import os
from pathlib import Path
from desktops import CHROME_FLAGS, chrome_bin
profile = Path(os.environ["HOME"]) / ".config" / ("chromium-display-" + os.environ["DISPLAY"].lstrip(":"))
os.execv(chrome_bin(), [chrome_bin(), "--user-data-dir=" + str(profile), "--start-maximized", *CHROME_FLAGS])
'
fi
exit 0
