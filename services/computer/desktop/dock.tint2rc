# Bottom dock: browser, files, terminal. Icons only, so it stays small.
rounded = 0
border_width = 0
background_color = #111b2b 100
border_color = #27364b 100

panel_items = L
panel_size = 100% 52
panel_margin = 0 0
panel_padding = 8 0 8
panel_background_id = 1
wm_menu = 0
panel_dock = 1
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
panel_shrink = 0
autohide = 0
strut_policy = follow_size
panel_window_name = teammates-dock
disable_transparency = 1
font_shadow = 0
mouse_effects = 0

launcher_padding = 8 0 4
launcher_background_id = 0
launcher_icon_size = 32
launcher_item_app = /opt/desk/applications/chromium.desktop
launcher_item_app = /opt/desk/applications/files.desktop
launcher_item_app = /opt/desk/applications/terminal.desktop
launcher_tooltip = 1
startup_notifications = 0
