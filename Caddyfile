{
	admin off
	auto_https off
}

(routes) {
	@compress not path /api/events /vnc/*
	encode @compress zstd gzip
	header {
		X-Content-Type-Options nosniff
		?Referrer-Policy same-origin
		X-Frame-Options SAMEORIGIN
	}
	handle /api/events {
		reverse_proxy api:8080 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /health {
		reverse_proxy api:8080
	}
	# /internal/* and /metrics are not published on the public ports.
	# The worker calls http://api:8080 on the internal Docker network.
	# Prometheus scrapes that address with METRICS_TOKEN.
	# Test-only paths: set CADDYFILE=./deploy/Caddyfile.test with
	# ENABLE_TEST_HOOKS=true. Do not do that on a shared host.
	handle /vnc/* {
		reverse_proxy api:8080 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
	handle {
		reverse_proxy web:3000
	}
}

# Separate admin site. It proxies the API for same-origin cookies and does
# not publish /internal/*, /metrics, or /vnc/*. ADMIN_ALLOWLIST is optional
# space-separated CIDRs. Unset allows every address.
(admin_routes) {
	@compress not path /api/events /vnc/*
	encode @compress zstd gzip
	handle /api/events {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options SAMEORIGIN
	}
	@admin_denied not remote_ip {$ADMIN_ALLOWLIST:0.0.0.0/0 ::/0}
	respond @admin_denied "Forbidden" 403
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /health {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy admin:3000
	}
}

:80 {
	import routes
}

:443 {
	tls internal
	import routes
}

:8081 {
	import admin_routes
}
