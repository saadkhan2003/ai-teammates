APP_DOMAIN=localhost

# OpenRouter is NOT configured here. The owner connects a key in
# Settings → Secrets (BYOK). The model gateway resolves secret://openrouter/default.
# See README "Secrets".
OPENROUTER_BASE_URL=http://mock-openrouter:8090/api/v1
LLM_PROVIDER=mock
MODEL_FAST=mock/planner
MODEL_PLANNER=mock/planner
MODEL_REVIEWER=mock/planner
MODEL_VISION=mock/planner
MODEL_EMBEDDING=local-hash-64

# Path inside the API container. The file is a Docker secret, not a variable.
SECRETS_MASTER_KEY_FILE=/run/secrets/secrets_master_key

# Operator credentials. Compose injects these only into the services that need
# them (API, Postgres, object store). They are not given to the agent or the
# user computer. Change them before exposing a host to a network.
POSTGRES_DB=agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=teammates-dev

S3_ENDPOINT=http://object-store:8333
S3_BUCKET=artifacts
S3_ACCESS_KEY=agent
S3_SECRET_KEY=teammates-dev-s3
S3_REGION=us-east-1

OWNER_USERNAME=saad
OWNER_PASSWORD=teammates-dev

# Internal service tokens. The agent has the worker token only.
# User computers receive COMPUTER_TOKEN and nothing else.
WORKER_TOKEN=dev-worker-token-change-me
COMPUTER_TOKEN=dev-computer-token-change-me
METRICS_TOKEN=dev-metrics-token-change-me
# Host firewall guard. Not given to the agent or to user computers.
ISOLATION_TOKEN=dev-isolation-token-change-me

MAX_PARALLEL_TASKS_PER_USER=6
MAX_BROWSER_TABS_PER_IDENTITY=8
MAX_PARALLEL_MODEL_CALLS_PER_USER=4
# Leave MAX_COMPUTERS unset and the API picks 2 when MemTotal is under 6 GiB
# (a 4 GB machine) and 3 on an 8 GB machine. Set a number to override.
# MAX_COMPUTERS=2

# Test-only hook that creates a second user for the wrong-user secret test.
# Set to false on any shared or public host.
ENABLE_TEST_HOOKS=true

DISPLAY_GEOMETRY=1024x768
DISPLAY_DEPTH=16
IDLE_SUSPEND_MINUTES=10
# hibernate stops an idle computer so its RAM returns to the host (resume is a few seconds).
# reclaim pauses and asks the kernel to drop cache. pause keeps the RAM reserved.
# IDLE_POWER=hibernate
# IDLE_HIBERNATE_MINUTES=30
# IDLE_RESUME_TARGET_SECONDS=15
# Official MCP registry import. 0 keeps the scheduled job off. Staff can still queue it.
# PLUGIN_IMPORT_INTERVAL_MINUTES=1440
# MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io

API_URL=http://api:8080
WORKER_ID=worker-1

# Compute lives inside the API. Docker is reached only through the socket proxy.
COMPUTE_PROVIDER=docker
COMPUTE_IMAGE=teammates-computer:dev
COMPUTE_NETWORK=teammates-computers
DOCKER_HOST=tcp://docker-proxy:2375
# The API container reads this mounted file and sends the JSON to dockerd.
# The engine API does not open a host path from seccomp=.
SECCOMP_PROFILE=/var/lib/teammates/seccomp-chrome.json
SNAPSHOT_DIR=/var/lib/teammates/snapshots
WORKER_PARALLEL_TASKS=4
