# Public edge for a real hostname. Replace example.com and the email.
# Caddy obtains a certificate from Let's Encrypt. Login attempts are
# limited in the API (Caddy has no built-in rate limiter).
# /internal/* and /metrics stay off this proxy. The worker and Prometheus
# use http://api:8080 on the internal Docker network.
{
	admin off
	email admin@example.com
}

(routes) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options SAMEORIGIN
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# noVNC opens a same-origin WebSocket at /vnc/websockify.
		# connect-src 'self' allows that ws/wss endpoint. worker-src blob
		# covers the noVNC worker. Next.js ships inline styles.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self' blob:; form-action 'self'"
		-Server
	}
	request_body {
		max_size 32MB
	}
	handle /api/events {
		reverse_proxy api:8080 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /health {
		reverse_proxy api:8080
	}
	handle /vnc/* {
		reverse_proxy api:8080 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
	handle {
		reverse_proxy web:3000
	}
}

# admin.example.com is the staff site. Same optional ADMIN_ALLOWLIST as the
# dev file (space-separated CIDRs). It does not publish /internal/*, /metrics,
# or /vnc/*.
(admin_routes) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options SAMEORIGIN
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self' blob:; form-action 'self'"
		-Server
	}
	request_body {
		max_size 32MB
	}
	@admin_denied not remote_ip {$ADMIN_ALLOWLIST:0.0.0.0/0 ::/0}
	handle @admin_denied {
		respond "Forbidden" 403
	}
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /health {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy admin:3000
	}
}

example.com {
	tls {
		issuer acme
	}
	import routes
}

www.example.com {
	redir https://example.com{uri} permanent
}

admin.example.com {
	tls {
		issuer acme
	}
	import admin_routes
}
