{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teammates Companion",
  "version": "0.4.0",
  "identifier": "com.teammates.companion",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
